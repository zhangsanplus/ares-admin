{
  "name": "ares-admin",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "description": "A management system template based on Vue3 and Element Plus",
  "author": "zhangsanplus",
  "license": "MIT",
  "homepage": "https://github.com/zhangsanplus/ares-admin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangsanplus/ares-admin.git"
  },
  "bugs": {
    "url": "https://github.com/zhangsanplus/ares-admin/issues"
  },
  "keywords": [
    "vue3",
    "element-plus",
    "typescript",
    "vue3 admin",
    "vue-admin-template",
    "ares-admin"
  ],
  "engines": {
    "node": ">=18.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "build:test": "vue-tsc --noEmit && vite build --mode test",
    "preview": "npm run build && vite preview --host",
    "report": "cross-env REPORT=true npm run build",
    "lint:css": "stylelint **/*.{css,scss,vue} --fix",
    "lint:js": "eslint --fix",
    "lint:ls": "ls-lint",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:ls && npm run typecheck",
    "typecheck": "vue-tsc --noEmit",
    "commit": "git-cz",
    "release": "bumpp",
    "upgrade": "taze major -I",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^14.1.0",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.1",
    "lodash-es": "^4.17.22",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "valr": "^0.0.4",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4",
    "vue3-slide-verify": "^1.1.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.0.0",
    "@babel/core": "^7.28.6",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@iconify-json/ep": "^1.2.3",
    "@ls-lint/ls-lint": "^2.3.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.0.8",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "@vue/babel-plugin-jsx": "^2.0.1",
    "autoprefixer": "^10.4.23",
    "bumpp": "^10.4.0",
    "commitizen": "^4.3.1",
    "cross-env": "^10.1.0",
    "cz-git": "^1.12.0",
    "eslint": "^9.39.2",
    "lint-staged": "^16.2.7",
    "mrm": "^4.1.22",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.97.2",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^16.26.1",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^39.0.1",
    "taze": "^19.9.2",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-icons": "^22.5.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.1",
    "vite-plugin-bundle-obfuscator": "^1.10.0",
    "vite-plugin-compression": "^0.5.1",
    "vue-tsc": "^3.2.2"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx --no -- commitlint --edit ${1}"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix"
    ],
    "src/**/*.{css,vue,scss}": [
      "stylelint --fix"
    ],
    "src/**": [
      "ls-lint"
    ]
  }
}
