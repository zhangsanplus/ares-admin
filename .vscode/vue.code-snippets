{
  "Dialog Template": {
    "scope": "vue",
    "prefix": [
      "dialog",
      "el-dialog"
    ],
    "body": [
      "<template>",
      "  <ElDialog",
      "    v-model=\"dialogVisible\"",
      "    title=\"${1:弹窗名称}\"",
      "    width=\"520px\"",
      "    :close-on-press-escape=\"false\"",
      "    :close-on-click-modal=\"false\"",
      "    append-to-body",
      "  >",
      "    <!-- footer -->",
      "    <template #footer>",
      "      <ElRow type=\"flex\" justify=\"center\">",
      "        <ElButton @click=\"handleCancel\">",
      "          取消",
      "        </ElButton>",
      "        <ElButton type=\"primary\" @click=\"handleConfirm\">",
      "          确定",
      "        </ElButton>",
      "      </ElRow>",
      "    </template>",
      "",
      "    <!-- body -->",
      "    <ElForm",
      "      ref=\"dialogFormRef\"",
      "      :model=\"dialogForm\"",
      "      :rules=\"dialogRules\"",
      "      label-position=\"top\"",
      "      hide-required-asterisk",
      "    >",
      "      <ElFormItem prop=\"name\" label=\"名称\">",
      "        <ElInput v-model=\"dialogForm.name\" placeholder=\"请输入名称\" />",
      "      </ElFormItem>",
      "    </ElForm>",
      "  </ElDialog>",
      "</template>",
      "",
      "<script setup>",
      "const emit = defineEmits(['complete'])",
      "const dialogVisible = defineModel('visible', false)",
      "",
      "// const fullLoading = useFullscreenLoading()",
      "const dialogFormRef = ref()",
      "const dialogForm = reactive({",
      "  ${3:name: '',}",
      "})",
      "const dialogRules = {}",
      "",
      "/**",
      " * 确认",
      " */",
      "async function handleConfirm() {",
      "  await dialogFormRef.value.validate()",
      "  emit('complete')",
      "}",
      "",
      "/**",
      " * 取消",
      " */",
      "function handleCancel() {",
      "  dialogVisible.value = false",
      "}",
      "</script>",
      "",
      "<style scoped lang=\"scss\"></style>",
      ""
    ],
    "description": "创建一个默认的弹窗"
  },
  "Page Template": {
    "scope": "vue",
    "prefix": [
      "<tem",
      "page"
    ],
    "body": [
      "<template>",
      "  <div class=\"page-container\">",
      "    ${1:$RELATIVE_FILEPATH}",
      "  </div>",
      "</template>",
      "",
      "<script setup></script>",
      "",
      "<style lang=\"scss\" scoped></style>"
    ],
    "description": "创建一个新的 VUE 组件"
  },
}
